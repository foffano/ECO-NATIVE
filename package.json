{
  "name": "eco-native-studio",
  "version": "0.1.44",
  "private": false,
  "description": "AI-assisted e-commerce listing studio for product research, content generation, image creation, and marketplace export.",
  "author": "ECO Native",
  "repository": {
    "type": "git",
    "url": "https://github.com/foffano/ECO-NATIVE.git"
  },
  "type": "module",
  "scripts": {
    "background:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/background.ps1 install",
    "background:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/background.ps1 uninstall",
    "background:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/background.ps1 start",
    "background:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/background.ps1 stop",
    "background:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/background.ps1 status",
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev:backend": ".venv\\Scripts\\python.exe scripts/ensure_playwright.py && .venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --reload-dir backend --host 127.0.0.1 --port 18765",
    "build": "npm.cmd run build:frontend",
    "build:frontend": "tsc -b && vite build",
    "build:playwright": ".venv\\Scripts\\python.exe scripts/prepare_playwright.py",
    "start": "npm run build:frontend && .venv\\Scripts\\python.exe -m backend.web_server",
    "serve": ".venv\\Scripts\\python.exe -m backend.web_server",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
